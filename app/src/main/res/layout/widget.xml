<?xml version="1.0" encoding="utf-8"?>
<!-- Le widget : les textes (ouvrent l'application), puis précédent, lecture ou pause, suivant, arrêter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetFond"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fond"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <LinearLayout
        android:id="@+id/widgetTextes"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widgetPrecedent"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/precedent"
        android:src="@drawable/ic_precedent"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/widgetLecture"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/lire"
        android:src="@drawable/ic_lecture"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/widgetSuivant"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/suivant"
        android:src="@drawable/ic_suivant"
        android:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/widgetArret"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/arreter_la_lecture"
        android:src="@drawable/ic_arret"
        android:tint="#B3FFFFFF" />
</LinearLayout>
