<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Savoir quand le telephone change de reseau, pour rechercher le serveur a ce moment-la. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Le service de lecture tourne en avant-plan, ecran eteint compris. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Le reveil radio : a la minute, comme un reveil ; reprogramme au demarrage du telephone. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Depuis Android 13, la notification de lecture se demande. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lire le QR code d'appariement ; sans camera, l'adresse et le code se tapent. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- La mise a jour proposee : ouvrir l'installeur sur l'APK telecharge. Android demande encore a l'utilisateur. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Échanger ses radios avec un téléphone proche, en Bluetooth. Avant
         Android 12, trouver les téléphones proches passait par la permission
         de localisation ; depuis, « appareils à proximité », sans localisation. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- La raison d'etre du projet : les flux des stations sont, pour la
         plupart, en http simple. Une application a le droit de le dire. -->
    <application
        android:name=".UnicornRadio"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.UnicornRadio">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- « Ouvrir avec » : un fichier JSON depuis le gestionnaire de
                 fichiers, une piece jointe, un partage. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/json" />
                <!-- Un fichier OPML d'une autre application de podcasts. -->
                <data android:mimeType="text/x-opml" />
            </intent-filter>
        </activity>

        <!-- L'ecran Serveur : apparier, mettre a jour, se detacher. -->
        <activity
            android:name=".ServeurActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- La langue choisie par les drapeaux est gardee par AppCompat, meme
             avant Android 13 ou le systeme ne la garde pas lui-meme. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <service
            android:name=".lecture.ServiceLecture"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Les touches multimédia, du widget ou d'ailleurs, quand le service ne tourne pas :
             Media3 le réveille, et « lecture » reprend la dernière écoute. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Le réveil radio : l'heure venue, le téléphone redémarré, l'application mise à jour, l'heure changée. -->
        <receiver
            android:name=".lecture.Reveil$Recepteur"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Les notifications de ce qui est programmé : « Annuler », « Ne pas sonner cette fois ». -->
        <receiver
            android:name=".lecture.Annonces$Recepteur"
            android:exported="false" />

        <!-- Le widget de l'écran d'accueil. -->
        <receiver
            android:name=".lecture.Widget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
